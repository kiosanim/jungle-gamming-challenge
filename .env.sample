# Valores de desenvolvimento local, prontos para usar com o docker-compose.
# Copie para .env (cp .env.sample .env) e ajuste se precisar. As senhas
# daqui servem só para a máquina de desenvolvimento; nunca use em produção.

PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=poc_user
DATABASE_PASSWORD=qwerty
DATABASE_NAME=poc_db
TEST_DATABASE_NAME=poc_db_test
WORKERS_ENABLED=true
PENDING_REFERENCE_INTERVAL_MS=1000
OUTBOX_PUBLISH_INTERVAL_MS=200
SQS_ENDPOINT_URL=http://localhost:4566
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
WAGER_TRANSACTIONS_QUEUE_NAME=wager-transactions.fifo
WAGER_TRANSACTIONS_DLQ_NAME=wager-transactions-dlq.fifo
OUTBOX_QUEUE_NAME=wagering-events.fifo
LOCK_TIMEOUT=4s
SQS_CONSUMER_CONCURRENCY=1
SQS_CONSUMER_MAX_ATTEMPTS=5
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
LOG_LEVEL=log
OUTBOX_PUBLISHER_CONCURRENCY=4
AUTH_ENABLED=true
AUTH_ISSUER=http://localhost:8080/realms/wagering
AUTH_AUDIENCE=wagering-api
AUTH_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
AUTH_PROVIDER_CLAIM=provider_id
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_ENABLED=false
OTEL_SERVICE_NAME=wagering
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=1
OUTBOX_RETENTION_HOURS=168
INBOX_RETENTION_HOURS=336
RETENTION_INTERVAL_MS=60000
