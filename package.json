{
  "name": "jungle-gamming-challenge",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect src/main.ts",
    "start:api": "bun src/main-api.ts",
    "start:consumer": "bun src/main-consumer.ts",
    "start:workers": "bun src/main-workers.ts",
    "lint": "oxlint src/ test/ scripts/ --ignore-pattern '**/migrations/**'",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun scripts/load-test.ts",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "sqs:setup": "bun scripts/sqs-setup.ts",
    "migration:create": "bun --bun node_modules/.bin/mikro-orm migration:create --config ./src/mikro-orm.config.ts",
    "migration:up": "bun --bun node_modules/.bin/mikro-orm migration:up --config ./src/mikro-orm.config.ts",
    "migration:down": "bun --bun node_modules/.bin/mikro-orm migration:down --config ./src/mikro-orm.config.ts",
    "migration:list": "bun --bun node_modules/.bin/mikro-orm migration:list --config ./src/mikro-orm.config.ts",
    "migration:pending": "bun --bun node_modules/.bin/mikro-orm migration:pending --config ./src/mikro-orm.config.ts",
    "migration:check": "bun --bun node_modules/.bin/mikro-orm migration:check --config ./src/mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1157.0",
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "jose": "^6.2.13",
    "module": "^2.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
